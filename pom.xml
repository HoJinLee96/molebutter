<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>
    <groupId>cc.ataglace</groupId>
    <artifactId>molebutter</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <properties>
        <java.version>21</java.version>
        <molebutter.build-directory>target</molebutter.build-directory>
    </properties>
    <modules>
        <module>molebutter-common</module>
        <module>molebutter-identity</module>
        <module>molebutter-operations</module>
        <module>molebutter-catalog</module>
        <module>molebutter-procurement</module>
        <module>molebutter-inventory</module>
        <module>molebutter-attendance</module>
        <module>molebutter-app</module>
    </modules>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.microsoft.playwright</groupId>
                <artifactId>playwright</artifactId>
                <version>1.63.0</version>
            </dependency>
            <dependency>
                <groupId>com.github.f4b6a3</groupId>
                <artifactId>tsid-creator</artifactId>
                <version>5.2.6</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>0.12.3</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>0.12.3</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>0.12.3</version>
            </dependency>
            <dependency>
                <groupId>cc.ataglace</groupId>
                <artifactId>molebutter-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cc.ataglace</groupId>
                <artifactId>molebutter-identity</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cc.ataglace</groupId>
                <artifactId>molebutter-operations</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cc.ataglace</groupId>
                <artifactId>molebutter-catalog</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cc.ataglace</groupId>
                <artifactId>molebutter-procurement</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cc.ataglace</groupId>
                <artifactId>molebutter-inventory</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cc.ataglace</groupId>
                <artifactId>molebutter-attendance</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cc.ataglace</groupId>
                <artifactId>molebutter-app</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <build>
        <directory>${molebutter.build-directory}</directory>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <configuration>
                        <excludes>
                            <exclude>application-secret/**</exclude>
                            <exclude>application-secret.properties</exclude>
                            <exclude>application-local.properties</exclude>
                            <exclude>application-*.local.properties</exclude>
                        </excludes>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
    <profiles>
        <profile>
            <id>integration-tests</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <includes>
                                <include>**/*Tests.java</include>
                                <include>**/*Test.java</include>
                                <include>**/*IT.java</include>
                            </includes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
